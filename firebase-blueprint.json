{
  "entities": {
    "SystemFinancials": {
      "title": "SystemFinancials",
      "description": "Global financial parameters and conversion rates set by administration",
      "type": "object",
      "properties": {
        "sharePriceUSD": {
          "type": "number",
          "description": "Indicative share price in USD"
        },
        "pointsPerShare": {
          "type": "number",
          "description": "Points needed to redeem 1 common share"
        },
        "referralBonusReferrer": {
          "type": "number",
          "description": "Points awarded to the referrer per new member"
        },
        "minRedemptionPoints": {
          "type": "number",
          "description": "Minimum points balance required for share conversion"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["sharePriceUSD", "pointsPerShare", "referralBonusReferrer"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Member profile information, shares balance, and reward points",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Member unique ID"
        },
        "memberId": {
          "type": "string",
          "description": "Human readable member ID (e.g. RB-88219)"
        },
        "fullName": {
          "type": "string",
          "description": "Member full name"
        },
        "email": {
          "type": "string",
          "description": "Member registered email"
        },
        "totalShares": {
          "type": "number",
          "description": "Total common and preferred shares held"
        },
        "commonShares": {
          "type": "number",
          "description": "Total common voting shares"
        },
        "preferredShares": {
          "type": "number",
          "description": "Total preferred dividend shares"
        },
        "rewardPoints": {
          "type": "number",
          "description": "Accumulated reward points"
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code"
        },
        "isDemo": {
          "type": "boolean",
          "description": "Whether this account is an archived demo template"
        }
      },
      "required": ["id", "memberId", "fullName", "totalShares"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Deposit, withdrawal, share acquisition, or point redemption record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "type": {
          "type": "string",
          "enum": ["Deposit", "Withdrawal", "Share Purchase", "Reward Points Conversion", "Share Transfer", "Dividend Payout"],
          "description": "Type of financial interaction"
        },
        "sharesAmount": {
          "type": "number",
          "description": "Amount of shares impacted"
        },
        "currencyAmount": {
          "type": "number",
          "description": "Amount in fiat USD currency"
        },
        "pointsAmount": {
          "type": "number",
          "description": "Amount of reward points impacted"
        },
        "status": {
          "type": "string",
          "enum": ["Approved", "Pending", "Processing", "Rejected"],
          "description": "Execution status of the transaction"
        },
        "date": {
          "type": "string",
          "description": "Human readable or ISO date"
        },
        "note": {
          "type": "string",
          "description": "Administrative notes or description"
        },
        "isSimulated": {
          "type": "boolean",
          "description": "Whether this transaction was generated by the live demonstration engine"
        }
      },
      "required": ["id", "type", "status", "date"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Inbound investment and partnership submissions from visitors",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique submission ID"
        },
        "name": {
          "type": "string",
          "description": "Applicant full name"
        },
        "email": {
          "type": "string",
          "description": "Applicant email address"
        },
        "phone": {
          "type": "string",
          "description": "Applicant phone number"
        },
        "country": {
          "type": "string",
          "description": "Country of origin"
        },
        "sharesInterested": {
          "type": "number",
          "description": "Number of shares requested"
        },
        "message": {
          "type": "string",
          "description": "Message or project inquiry"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Reviewed", "Archived"],
          "description": "Status in the admin pipeline"
        },
        "date": {
          "type": "string",
          "description": "Submission date"
        }
      },
      "required": ["id", "name", "email", "status", "date"]
    },
    "DemoArchive": {
      "title": "DemoArchive",
      "description": "Archived simulated accounts and mock transaction batches kept in the Admin folder",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Archive package identifier"
        },
        "title": {
          "type": "string",
          "description": "Archive title or scenario name"
        },
        "description": {
          "type": "string",
          "description": "Detailed notes on what this demo pack contains"
        },
        "accountCount": {
          "type": "number",
          "description": "Number of sample accounts preserved in the folder"
        },
        "totalSimulatedShares": {
          "type": "number",
          "description": "Total volume of shares represented in this demo pack"
        },
        "createdAt": {
          "type": "string",
          "description": "Date when the demo accounts were retired from the live space"
        },
        "payloadJson": {
          "type": "string",
          "description": "Serialized data bundle containing the demo accounts and historic records"
        }
      },
      "required": ["id", "title", "payloadJson"]
    }
  },
  "firestore": {
    "/system_settings/{settingId}": {
      "schema": "SystemFinancials",
      "description": "Global settings and conversion rates configured by platform administrators"
    },
    "/members/{memberId}": {
      "schema": "MemberProfile",
      "description": "Active member portfolios and shareholder records"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Live transaction ledger including deposits, withdrawals, and share movements"
    },
    "/submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Investor inquiries and partnership contacts"
    },
    "/demo_archives/{archiveId}": {
      "schema": "DemoArchive",
      "description": "Administrative repository folder holding archived demo accounts and simulation templates"
    }
  }
}
